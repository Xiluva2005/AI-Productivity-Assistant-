import os, json

def summarize_meeting(transcript: str):
    if not transcript.strip():
        return {"error": "Please paste a transcript"}
    
    prompt = f"""Analyze meeting transcript step-by-step:
1. Main topics
2. Key decisions
3. Action items with owner
4. Overall sentiment
Transcript: {transcript}
Return JSON with keys: summary, decisions, action_items, open_questions
"""
    api_key = os.getenv("OPENAI_API_KEY")
    if api_key:
        try:
            from openai import OpenAI
            client = OpenAI(api_key=api_key)
            resp = client.chat.completions.create(
                model="gpt-4o-mini",
                messages=[{"role":"user","content":prompt}],
                response_format={"type":"json_object"}
            )
            return json.loads(resp.choices[0].message.content)
        except:
            pass
    
    # Heuristic fallback
    words = transcript.split()
    return {
        "summary": f"Meeting discussed {len(words)} words. Key focus extracted from transcript.",
        "decisions": ["No explicit decisions detected - review transcript"],
        "action_items": [{"task": "Review transcript and assign owners", "owner": "TBD", "deadline": "EOW"}],
        "open_questions": ["Follow-up required"],
        "transcript_preview": transcript[:300] + "..."
    }
